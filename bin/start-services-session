#!/bin/bash
# Idempotent launcher for the always-on tmux session.
# Exits cleanly if the session already exists, so systemd can re-run it safely
# and tmuxp never drops into its interactive "session exists" prompt.
if tmux has-session -t services 2>/dev/null; then
  echo "services session already running"
  exit 0
fi
exec "$HOME/.local/bin/tmuxp" load -d services
